---
import Base from '../layouts/Base.astro';
import Brand from '../components/Brand.astro';
import Icon from '../components/Icon.astro';
import { btn, DISPLAY, SUBTITLE, FIELD_FOCUS } from '../scripts/ui';
const input = `h-12 px-3.5 rounded-md border border-line-strong bg-surface text-[15px] w-full ${FIELD_FOCUS}`;
const label = 'text-sm font-semibold';
const spine = 'rounded-[8px] border-2';
---
<Base title="Iniciar sesión — Readflow">
  <div class="grid grid-cols-2 min-h-dvh max-md:grid-cols-1">
    <div class="bg-side px-14 py-12 flex flex-col justify-between gap-10 max-md:px-6 max-md:pt-8 max-md:pb-7 max-md:rounded-b-[28px] max-md:gap-6">
      <Brand />
      <div class="flex items-end justify-center gap-3.5 h-[340px] max-md:h-[150px] max-md:gap-2" aria-hidden="true">
        <span class={`${spine} w-[92px] h-[74%] bg-toread-bg border-[#D8CFF4] max-md:w-11`}></span>
        <span class={`${spine} w-[110px] h-[88%] bg-upnext-bg border-[#C6DCF3] max-md:w-[52px]`}></span>
        <span class={`${spine} w-[130px] h-full bg-reading-bg border-[#BFE5D2] flex items-end p-3.5 font-display font-bold text-[15px] text-reading-ink max-md:w-[62px] max-md:p-0 max-md:text-[0px]`}>Reading</span>
        <span class={`${spine} w-[100px] h-[80%] bg-onhold-bg border-[#F2E1A6] max-md:w-12`}></span>
        <span class={`${spine} w-[86px] h-[65%] bg-finished-bg border-[#F6CDB8] rotate-6 origin-bottom-left max-md:w-10`}></span>
      </div>
      <div class="flex flex-col gap-2.5 max-md:hidden">
        <p class={`${DISPLAY} text-[34px] leading-[1.1] max-w-[460px]`}>Tu biblioteca, de la carpeta al Kindle.</p>
        <p class={SUBTITLE}>Sube el EPUB, mueve el libro de estado y Readflow hace el resto.</p>
      </div>
    </div>

    <main class="flex items-center justify-center px-6 py-12 max-md:items-start max-md:pt-7 max-md:pb-8">
      <form class="w-full max-w-[400px] flex flex-col gap-[22px]" id="login-form" novalidate>
        <div class="flex flex-col gap-2">
          <h1 class={`${DISPLAY} leading-[1.05] text-[40px] max-md:text-[32px]`}>Hola de nuevo</h1>
          <p class={SUBTITLE}>Entra para seguir con tus lecturas.</p>
        </div>

        <div class="flex flex-col gap-1.5">
          <label class={label} for="email">Correo</label>
          <input class={input} id="email" type="email" autocomplete="username" required />
        </div>
        <div class="flex flex-col gap-1.5">
          <div class="flex justify-between items-baseline gap-3">
            <label class={label} for="password">Contraseña</label>
            <a href="#" class="text-[13px] font-semibold">¿La olvidaste?</a>
          </div>
          <input class={input} id="password" type="password" autocomplete="current-password" required />
        </div>
        <label class="flex items-center gap-2.5 min-h-11 text-sm text-ink-2 cursor-pointer">
          <input type="checkbox" class="size-[18px] m-0 accent-[#6E5FC7]" checked /> Mantener la sesión en este dispositivo
        </label>

        <button class={btn('primary', 'block')} type="submit">Entrar</button>
        <div class="flex items-center gap-3 text-muted-2 text-[13px] before:content-[''] before:flex-1 before:h-px before:bg-line-soft after:content-[''] after:flex-1 after:h-px after:bg-line-soft">o</div>
        <button class={btn('soft', 'block')} type="button" id="magic-link"><Icon name="mail" /> Enviarme un enlace mágico</button>

        <p class="text-[13px] text-muted-2 text-center">Readflow es de uso personal: no hay registro de nuevas cuentas.</p>
      </form>
    </main>
  </div>
</Base>

<script>
  import { initLogin } from '../scripts/login';
  initLogin();
</script>
