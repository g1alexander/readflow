---
import Base from '../layouts/Base.astro';
import CenteredPage from '../components/CenteredPage.astro';
import BackLink from '../components/BackLink.astro';
import Panel from '../components/Panel.astro';
import { btn, PAGE_TITLE, SUBTITLE, FIELD, FIELD_LABEL } from '../scripts/ui';
---
<Base title="Ajustes — Readflow" auth="private">
  <CenteredPage>
    <BackLink />

    <div class="flex flex-col gap-1.5">
      <h1 class={PAGE_TITLE}>Ajustes</h1>
      <p class={SUBTITLE}>Los libros que muevas a Reading se envían a este correo.</p>
    </div>

    <Panel title="Kindle" titleId="kindle-title">
      <form class="flex flex-col gap-4" id="settings-form" novalidate>
        <div class="flex flex-col gap-1.5">
          <label class={FIELD_LABEL} for="kindle-email">Correo de tu Kindle</label>
          <input class={FIELD} id="kindle-email" type="email" maxlength="254" placeholder="nombre@kindle.com" autocomplete="off" aria-describedby="kindle-help settings-error" />
          <p class="text-[13px] text-muted" id="kindle-help">Debe terminar en @kindle.com. Déjalo vacío para quitarlo.</p>
          <p class="text-[13px] font-semibold text-err-ink" id="settings-error" hidden></p>
        </div>
        <div class="flex flex-wrap gap-2.5">
          <button class={btn('primary')} type="submit" id="settings-save" disabled>Guardar</button>
        </div>
      </form>

      <section class="flex flex-col gap-2 border-t border-line-soft pt-4" aria-labelledby="amazon-steps-title">
        <h3 class="text-sm font-semibold" id="amazon-steps-title">Configúralo en Amazon</h3>
        <ol class="flex flex-col gap-2.5 list-decimal pl-5 text-sm leading-relaxed text-muted">
          <li>
            Abre <a class="font-semibold text-ink underline" href="https://www.amazon.com/hz/mycd/preferences/myx#/home/settings/payment" target="_blank" rel="noopener noreferrer">Configuración de documentos personales</a> (Cuenta → Contenido y dispositivos → Preferencias).
          </li>
          <li>
            En <strong>Lista de e-mails aprobados para documentos personales</strong> → <strong>Agregar una dirección nueva</strong>: <code class="font-mono text-ink">kindle@g1alexander.com</code>.
          </li>
          <li>En la misma sección copia la dirección <strong>Enviar a Kindle</strong> de tu dispositivo (<code class="font-mono">…@kindle.com</code>) y pégala arriba.</li>
        </ol>
      </section>
    </Panel>
  </CenteredPage>
</Base>

<script>
  import { initSettings } from '../scripts/settings';
  initSettings();
</script>
