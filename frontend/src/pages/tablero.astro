---
import Base from '../layouts/Base.astro';
import AppShell from '../components/AppShell.astro';
import SearchInput from '../components/SearchInput.astro';
import Icon from '../components/Icon.astro';
import { btn, PAGE_TITLE, SUBTITLE, SECTION_TITLE, CARD_TITLE, STATES_ROW, ICON_SM } from '../scripts/ui';
const hint = 'flex items-center gap-2.5 px-3.5 bg-reading-bg text-reading-ink text-[13px] font-medium';
---
<Base title="Tablero de lectura — Readflow" auth="private">
  <AppShell current="/tablero">
    <div slot="aside" class="bg-s-bg rounded-2xl p-4 flex flex-col gap-1.5 text-s-ink text-[13px]" data-state="toread" id="kindle-card">
      <strong class="flex items-center gap-2 text-s-ink text-sm"><span class="size-2 rounded-full bg-s-dot"></span><span id="kindle-status">Kindle</span></strong>
      <a class="break-all text-s-ink opacity-90 hover:opacity-100" href="/ajustes" id="kindle-email"></a>
      <small class="text-xs text-s-ink opacity-80" id="kindle-last"></small>
    </div>

    <header class="flex flex-wrap items-end justify-between gap-4 max-md:items-center max-md:flex-nowrap">
      <div class="flex flex-col gap-1.5">
        <h1 class={PAGE_TITLE}>Tablero<span class="max-md:hidden"> de lectura</span></h1>
        <p class={`${SUBTITLE} text-[15px] max-md:text-[13px]`} id="summary"></p>
      </div>
      <div class="flex items-center gap-3">
        <SearchInput />
        <a class={`${btn('primary')} max-md:hidden`} href="/subir"><Icon name="upload" class={ICON_SM} /> Subir EPUB</a>
        <button class={`${btn('outline', 'icon')} md:hidden`} type="button" data-logout aria-label="Cerrar sesión"><Icon name="logout" /></button>
      </div>
    </header>

    <section class="flex flex-col gap-3.5" aria-labelledby="now-title">
      <h2 class={SECTION_TITLE} id="now-title">Leyendo ahora</h2>
      <div class="max-md:flex max-md:gap-3 max-md:overflow-x-auto max-md:-mx-5 max-md:px-5 max-md:[scrollbar-width:none]">
        <div class="grid grid-cols-2 gap-4 max-[1100px]:grid-cols-1 max-md:contents" id="now"></div>
      </div>
    </section>

    <section class="flex flex-col gap-3.5" aria-labelledby="board-title">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class={SECTION_TITLE} id="board-title">Por estado</h2>
        <p class={`${hint} py-2 rounded-full max-md:hidden`}><Icon name="mail" /> Arrastra un libro a Reading y se envía solo a tu Kindle</p>
      </div>
      <div class="grid grid-cols-[repeat(6,minmax(160px,1fr))] gap-3.5 items-start overflow-x-auto pb-1.5 max-md:hidden" id="board"></div>

      <div class="md:hidden flex gap-2 overflow-x-auto -mx-5 px-5 pb-0.5 [scrollbar-width:none]" id="tabs" role="tablist" aria-label="Estados de lectura"></div>
      <div class="md:hidden p-2.5 rounded-lg bg-s-bg flex flex-col gap-2" id="mlist" role="tabpanel"></div>
      <p class={`${hint} py-2.5 rounded-[14px] md:hidden`}>Mantén presionado un libro para cambiarlo de estado. A Reading se envía solo al Kindle.</p>
    </section>
  </AppShell>

  <dialog class="mx-auto mt-auto mb-0 w-full max-w-[520px] rounded-t-3xl bg-surface text-ink p-0 border-0 backdrop:bg-ink/35" id="move-sheet" aria-labelledby="sheet-title">
    <div class="px-5 pt-5 pb-[calc(24px+env(safe-area-inset-bottom,0px))] flex flex-col gap-3.5">
      <span class="w-10 h-1 rounded-[4px] bg-line-strong mx-auto mb-1" aria-hidden="true"></span>
      <div class="flex justify-between items-baseline gap-3">
        <h2 class={CARD_TITLE} id="sheet-title"></h2>
        <button class={btn('ghost')} type="button" id="sheet-close">Cerrar</button>
      </div>
      <p class={`${SUBTITLE} text-sm`}>Mover a:</p>
      <div class={STATES_ROW} id="sheet-states"></div>
    </div>
  </dialog>
</Base>

<script>
  import { initBoard } from '../scripts/board';
  initBoard();
</script>
