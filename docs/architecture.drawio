                <mxCell id="e16" value="evento ObjectCreated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#879196;strokeWidth=2;fontSize=11;fontColor=#5A6B7B;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s3notes" target="lnotes" edge="1">
